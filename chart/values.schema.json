                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._+-]{1,200}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "ssg",
                          "disa",
                          "custom"
                        ]
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https?://"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
                      },
                      "include": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "offline": {
                  "type": "boolean"
                },
                "refreshHours": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "disa": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "object",
