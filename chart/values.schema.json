          "type": [
            "integer",
            "string",
            "null"
          ],
          "description": "RAW_MAX_GZ_BYTES: bytes or a Kubernetes quantity; null = application default (4Mi)",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|[kmgtpe])?$",
          "minimum": 1
        },
