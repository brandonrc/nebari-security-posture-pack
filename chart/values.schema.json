                "type": [
                  "object",
                  "string"
                ]
              }
            },
            "scannerFlags": {
              "type": "boolean",
              "description": "VEX_SCANNER_FLAGS: also pass --vex to trivy/grype when scanning by image reference"
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
