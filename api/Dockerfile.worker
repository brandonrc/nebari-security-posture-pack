# syntax=docker/dockerfile:1
# Nebari Security Posture worker: same Python package as the API plus pinned scanner
# binaries (trivy client, grype, clairctl, cosign) and skopeo. Build context: api/
# Base: same decision as Dockerfile.api (Debian 13 slim, digest-pinned; docs/DECISIONS.md
# "2026-10-05: image hardening"); remaining unfixed Debian CVEs: vex/posture-images.vex.json.
ARG PYTHON_IMAGE=python:3.13-slim-trixie@sha256:3dd7cc108ec1493442514f5c2a871af6af0ec31d768ff6e378a93340c3b3db5f
ARG GOLANG_IMAGE=golang:1.27.1-trixie@sha256:3b77fc618ec235a1ab412de7737f120dd507c57e8d87de4cbb7994fb94275ed5

FROM ${PYTHON_IMAGE} AS builder
# Dependencies come from uv.lock (hash-pinned, transitive deps included), so the
# image installs exactly what CI tested. Bump with `uv lock` (Dependabot: uv).
COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3 UV_NO_CACHE=1
WORKDIR /src
COPY pyproject.toml uv.lock README.md alembic.ini ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

# clairctl, cosign and skopeo are built from their tagged release sources with a current Go
# toolchain plus the minimum dependency bumps that clear the fixable CRITICAL/HIGH findings of the
# upstream binaries (Go stdlib, pgx, x/crypto, x/net, grpc, ...). Each tag must resolve to the
# pinned commit; module downloads are verified against go.sum / sum.golang.org (GOSUMDB default).
# Debian's skopeo (Go 1.24.4, plus containers-common, CNI plugins and gpgme) is not installed; this
# one is static (openpgp instead of gpgme, no btrfs/devicemapper graph drivers) and every call
# site passes --policy. When upstream releases carry these fixes, drop the bumps (or return to
# the sha256-pinned release binaries).
FROM ${GOLANG_IMAGE} AS gobuild
ARG CLAIR_VERSION=4.9.0
ARG CLAIR_COMMIT=f6a412ccbfc4c3db83005348584d437348826763
ARG CLAIR_GO_BUMPS="github.com/jackc/pgx/v5@v5.9.2 golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.59.0 golang.org/x/text@v0.42.0 github.com/go-jose/go-jose/v3@v3.0.5 go.opentelemetry.io/otel@v1.47.0 github.com/docker/cli@v29.8.2+incompatible"
ARG COSIGN_VERSION=3.1.3
ARG COSIGN_COMMIT=11926fa5bbbbde47e88fc006b625a17769b743b2
ARG COSIGN_GO_BUMPS="golang.org/x/crypto@v0.57.0 golang.org/x/mod@v0.41.0 golang.org/x/text@v0.42.0 google.golang.org/grpc@v1.84.0"
ARG SKOPEO_VERSION=1.24.1
ARG SKOPEO_COMMIT=77f3d92f861271c7cb9175afcf876017bcae9202
ARG SKOPEO_GO_BUMPS="golang.org/x/crypto@v0.57.0 google.golang.org/grpc@v1.84.0"
ENV CGO_ENABLED=0 GOFLAGS=-mod=mod GOTOOLCHAIN=local
WORKDIR /build
# fetch <repo> <tag> <commit> <go get args...>: shallow clone at the tag, check the commit, bump, tidy
RUN cat > /usr/local/bin/fetch <<'SH' && chmod 0755 /usr/local/bin/fetch
#!/bin/sh
set -eux
repo=$1 tag=$2 commit=$3; shift 3
git -c advice.detachedHead=false clone -q --depth 1 --branch "$tag" "https://github.com/$repo" src
test "$(git -C src rev-parse HEAD)" = "$commit"
cd src && rm -rf vendor && go get "$@" && go mod tidy
SH
RUN set -eux; fetch quay/clair "v${CLAIR_VERSION}" "${CLAIR_COMMIT}" ${CLAIR_GO_BUMPS}; \
    cd src && go build -trimpath -buildvcs=false \
      -ldflags "-s -w -buildid= -X github.com/quay/clair/v4/cmd.Version=v${CLAIR_VERSION}" -o /dl/clairctl ./cmd/clairctl; \
    cd .. && rm -rf src && /dl/clairctl --version
RUN set -eux; fetch sigstore/cosign "v${COSIGN_VERSION}" "${COSIGN_COMMIT}" ${COSIGN_GO_BUMPS}; \
    cd src && go build -trimpath -buildvcs=false \
      -ldflags "-s -w -buildid= -X sigs.k8s.io/release-utils/version.gitVersion=v${COSIGN_VERSION}" \
      -o /dl/cosign ./cmd/cosign; \
    cd .. && rm -rf src && /dl/cosign version
RUN set -eux; fetch containers/skopeo "v${SKOPEO_VERSION}" "${SKOPEO_COMMIT}" ${SKOPEO_GO_BUMPS}; \
    cd src && go build -trimpath -buildvcs=false \
      -tags "containers_image_openpgp exclude_graphdriver_btrfs exclude_graphdriver_devicemapper" \
      -ldflags "-s -w -buildid= -X main.gitCommit=${SKOPEO_COMMIT}" -o /dl/skopeo ./cmd/skopeo; \
    cd .. && rm -rf src && /dl/skopeo --version

FROM ${PYTHON_IMAGE} AS tools
ARG TRIVY_VERSION=0.75.0
ARG TRIVY_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
ARG GRYPE_VERSION=0.120.0
ARG GRYPE_SHA256=a5a1218dce63acdac152a6b3b5bb366e7267e36f4069848cf455543b3fa5700e
# (sha256 values are the ones in each release's checksums file; clairctl and cosign, the supply-
# chain stage's signature verifier (DESIGN §12), come from the gobuild stage above)
# oscap-chroot (DESIGN §14): a 3 KB shell wrapper that sets OSCAP_PROBE_ROOT and runs `oscap`.
# Debian ships it in openscap-utils, which drags in rpm, python3-openscap and a second python;
# only the script is taken from the (apt-verified, sha256-pinned) package.
ARG OPENSCAP_DEB_VERSION=1.4.2+dfsg-1
ARG OPENSCAP_UTILS_SHA256=38612978dbedae54e60b2359312d74063e2290f34137116469613ddd4c7f1332
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
RUN set -eux; \
    curl -fsSLo trivy.tgz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    echo "${TRIVY_SHA256}  trivy.tgz" | sha256sum -c -; \
    tar -xzf trivy.tgz trivy; \
    curl -fsSLo grype.tgz "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz"; \
    echo "${GRYPE_SHA256}  grype.tgz" | sha256sum -c -; \
    tar -xzf grype.tgz grype; \
    chmod 0755 trivy grype; \
    rm -f trivy.tgz grype.tgz
RUN set -eux; \
    apt-get update; \
    apt-get download "openscap-utils=${OPENSCAP_DEB_VERSION}"; \
    echo "${OPENSCAP_UTILS_SHA256}  $(ls openscap-utils_*.deb)" | sha256sum -c -; \
    dpkg-deb -x openscap-utils_*.deb ou; \
    install -m 0755 ou/usr/bin/oscap-chroot /dl/oscap-chroot; \
    rm -rf ou openscap-utils_*.deb /var/lib/apt/lists/*

FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="security-posture-worker" \
      org.opencontainers.image.source="https://github.com/nebari-dev/nebari-security-posture-pack"
# skopeo (static, gobuild stage) for mirroring; pango/harfbuzz/fonts for WeasyPrint (SAR PDF from reports.autoGenerate);
# openscap-scanner (`oscap`, OVAL probes incl. dpkginfo/rpminfo) + bzip2/xz/zstd for the SCAP stage
# (DESIGN §14); rpm-common supplies /usr/lib/rpm/rpmrc, without which librpm (the rpminfo probe used
# for RHEL / UBI images) aborts oscap. No SCAP content is vendored: it is fetched to SCAP_CONTENT_DIR
# at runtime.
# Also: apt-get upgrade (Debian fixes newer than the base digest); mount purged (unprivileged
# container, see the VEX); no pip/setuptools/ensurepip/idle/tkinter (the app runs from /opt/venv).
ARG OPENSCAP_DEB_VERSION=1.4.2+dfsg-1
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends ca-certificates \
      libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 fonts-dejavu-core \
      "openscap-scanner=${OPENSCAP_DEB_VERSION}" "openscap-common=${OPENSCAP_DEB_VERSION}" bzip2 xz-utils zstd \
      rpm-common \
 && apt-get purge -y mount \
 && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/apt /var/log/dpkg.log \
 && rm -rf /usr/local/bin/pip* /usr/local/bin/idle* /usr/local/bin/pydoc* \
      /usr/local/lib/python3*/site-packages/pip* /usr/local/lib/python3*/site-packages/setuptools* \
      /usr/local/lib/python3*/site-packages/wheel* /usr/local/lib/python3*/ensurepip \
      /usr/local/lib/python3*/idlelib /usr/local/lib/python3*/tkinter \
 && groupadd --gid 10001 posture \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin posture \
 && mkdir -p /cache /data/reports && chown 10001:10001 /cache /data/reports
COPY --from=tools /dl/trivy /dl/grype /dl/oscap-chroot /usr/local/bin/
COPY --from=gobuild /dl/clairctl /dl/cosign /dl/skopeo /usr/local/bin/
COPY --from=builder /opt/venv /opt/venv
# The pack's own OpenVEX statements (VEX_BUILTIN_DIR): applied to the worker's scans of its own
# images; operators add theirs under VEX_DIR (chart scanner.vex).
COPY vex/ /etc/posture/vex/
# fail the build when the SCAP toolchain is incomplete
# OpenSCAP probe environment (validated on grace, DESIGN §14):
# - dpkginfo reads the image's /var/lib/dpkg/status through libapt-pkg with RootDir=<rootfs>; the
#   base image's apt.conf.d/docker-clean sets Dir::Cache::pkgcache "" which RootDir turns into
#   "<rootfs>/" and apt fails ("dpkginfo_init has failed", every package rule false). Name the
#   cache files again (they land in the scratch rootfs' var/cache/apt).
# - rpminfo uses this image's rpm macros, and Debian's rpm keeps its database in ~/.rpmdb; RHEL /
#   UBI images keep it in /var/lib/rpm.
RUN printf 'Dir::Cache::pkgcache "pkgcache.bin";\nDir::Cache::srcpkgcache "srcpkgcache.bin";\n' \
      > /etc/apt/apt.conf.d/zz-posture-oscap \
 && mkdir -p /etc/rpm && printf '%%_dbpath /var/lib/rpm\n' > /etc/rpm/macros.posture-oscap
RUN oscap --version | head -1 && test -x /usr/local/bin/oscap-chroot && test -f /usr/lib/rpm/rpmrc
# Everything the tools write goes under /cache (PVC) or /tmp (emptyDir): the root fs
# can be read-only.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local/share \
    XDG_RUNTIME_DIR=/tmp/run \
    CACHE_DIR=/cache \
    GRYPE_DB_CACHE_DIR=/cache/grype \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_CHECK_FOR_APP_UPDATE=false \
    TRIVY_CACHE_DIR=/cache/trivy-client \
    TRIVY_NO_PROGRESS=true \
    TUF_ROOT=/cache/sigstore \
    WORKER_HEALTH_PORT=9000
USER 10001:10001
VOLUME ["/cache"]
EXPOSE 9000
CMD ["python", "-m", "posture.worker"]
