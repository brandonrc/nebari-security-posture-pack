# syntax=docker/dockerfile:1
# Nebari Security Posture worker: same Python package as the API plus pinned scanner
# binaries (trivy client, grype, clairctl) and skopeo. Build context: api/
ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /src
COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
RUN pip install --upgrade pip==25.2 && pip install .

FROM ${PYTHON_IMAGE} AS tools
ARG TRIVY_VERSION=0.75.0
ARG TRIVY_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
ARG GRYPE_VERSION=0.120.0
ARG GRYPE_SHA256=a5a1218dce63acdac152a6b3b5bb366e7267e36f4069848cf455543b3fa5700e
ARG CLAIRCTL_VERSION=4.9.0
ARG CLAIRCTL_SHA256=202ba386620bb8720631e34381fa24621536045ff898dd6d08a3b64ee3d52328
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
RUN set -eux; \
    curl -fsSLo trivy.tgz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    echo "${TRIVY_SHA256}  trivy.tgz" | sha256sum -c -; \
    tar -xzf trivy.tgz trivy; \
    curl -fsSLo grype.tgz "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz"; \
    echo "${GRYPE_SHA256}  grype.tgz" | sha256sum -c -; \
    tar -xzf grype.tgz grype; \
    curl -fsSLo clairctl "https://github.com/quay/clair/releases/download/v${CLAIRCTL_VERSION}/clairctl-linux-amd64"; \
    echo "${CLAIRCTL_SHA256}  clairctl" | sha256sum -c -; \
    chmod 0755 trivy grype clairctl

FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.title="security-posture-worker" \
      org.opencontainers.image.source="https://github.com/nebari-dev/nebari-security-posture-pack"
RUN apt-get update \
 && apt-get install -y --no-install-recommends skopeo ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 posture \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin posture \
 && mkdir -p /cache && chown 10001:10001 /cache
COPY --from=tools /dl/trivy /dl/grype /dl/clairctl /usr/local/bin/
COPY --from=builder /opt/venv /opt/venv
# Everything the tools write goes under /cache (PVC) or /tmp (emptyDir): the root fs
# can be read-only.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local/share \
    XDG_RUNTIME_DIR=/tmp/run \
    CACHE_DIR=/cache \
    GRYPE_DB_CACHE_DIR=/cache/grype \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_CHECK_FOR_APP_UPDATE=false \
    TRIVY_CACHE_DIR=/cache/trivy-client \
    TRIVY_NO_PROGRESS=true \
    WORKER_HEALTH_PORT=9000
USER 10001:10001
VOLUME ["/cache"]
EXPOSE 9000
CMD ["python", "-m", "posture.worker"]
