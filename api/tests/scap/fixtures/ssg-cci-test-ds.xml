<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal SSG-style source datastream (XCCDF 1.2) for the CCI derivation tests: like SSG 0.1.82,
     the rules reference the DISA STIG by SV- rule id, V-ID and STIG rule version (cyber.mil
     hrefs) but carry no CCI idents. Made-up ids (V-100001.., TEST-09-..). Not evaluable (no OVAL). -->
<ds:data-stream-collection xmlns:ds="http://scap.nist.gov/schema/scap/source/1.2"
    xmlns:xlink="http://www.w3.org/1999/xlink" id="scap_org.open-scap_collection_from_xccdf_ssg-test"
    schematron-version="1.3">
  <ds:data-stream id="scap_org.open-scap_datastream_from_xccdf_ssg-test" scap-version="1.3" use-case="CONFIGURATION">
    <ds:checklists>
      <ds:component-ref id="scap_org.open-scap_cref_ssg-test-xccdf" xlink:href="#scap_org.open-scap_comp_ssg-test-xccdf"/>
    </ds:checklists>
  </ds:data-stream>
  <ds:component id="scap_org.open-scap_comp_ssg-test-xccdf" timestamp="2026-10-05T00:00:00">
    <xccdf-1.2:Benchmark xmlns:xccdf-1.2="http://checklists.nist.gov/xccdf/1.2"
        id="xccdf_org.ssgproject.content_benchmark_TEST-9" resolved="1" style="SCAP_1.2">
      <xccdf-1.2:status date="2026-10-01">draft</xccdf-1.2:status>
      <xccdf-1.2:title>Guide to the Secure Configuration of Test Linux 9</xccdf-1.2:title>
      <xccdf-1.2:version>0.1.82</xccdf-1.2:version>
      <xccdf-1.2:Profile id="xccdf_org.ssgproject.content_profile_stig">
        <xccdf-1.2:title>DISA STIG for Test Linux 9</xccdf-1.2:title>
        <xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_sv_match" selected="true"/>
      </xccdf-1.2:Profile>
      <xccdf-1.2:Group id="xccdf_org.ssgproject.content_group_system">
        <xccdf-1.2:title>System Settings</xccdf-1.2:title>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_sv_match" severity="high">
          <xccdf-1.2:title>SV id match (older revision than the DISA benchmark)</xccdf-1.2:title>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/downloads/?_dl_facet_stigs=operating-systems%2Cunix-linux">TEST-09-000010</xccdf-1.2:reference>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/srg-stig-tools/">SV-100001r2_rule</xccdf-1.2:reference>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/srg-stig-tools#vulnerability_id">V-100001</xccdf-1.2:reference>
          <xccdf-1.2:ident system="https://ncp.nist.gov/cce">CCE-00001-1</xccdf-1.2:ident>
        </xccdf-1.2:Rule>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_v_match" severity="medium">
          <xccdf-1.2:title>V-ID only</xccdf-1.2:title>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/srg-stig-tools#vulnerability_id">V-100002</xccdf-1.2:reference>
        </xccdf-1.2:Rule>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_ver_match" severity="low">
          <xccdf-1.2:title>STIG rule version only</xccdf-1.2:title>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/downloads/?_dl_facet_stigs=operating-systems%2Cunix-linux">TEST-09-000030</xccdf-1.2:reference>
        </xccdf-1.2:Rule>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_unmatched" severity="medium">
          <xccdf-1.2:title>STIG id the DISA benchmark does not list</xccdf-1.2:title>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/srg-stig-tools#vulnerability_id">V-199999</xccdf-1.2:reference>
        </xccdf-1.2:Rule>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_no_stig" severity="low">
          <xccdf-1.2:title>Not in the STIG</xccdf-1.2:title>
          <xccdf-1.2:ident system="https://ncp.nist.gov/cce">CCE-00005-1</xccdf-1.2:ident>
        </xccdf-1.2:Rule>
        <xccdf-1.2:Rule id="xccdf_org.ssgproject.content_rule_own_cci" severity="medium">
          <xccdf-1.2:title>Carries its own CCI</xccdf-1.2:title>
          <xccdf-1.2:reference href="https://www.cyber.mil/stigs/srg-stig-tools#vulnerability_id">V-100001</xccdf-1.2:reference>
          <xccdf-1.2:ident system="http://cyber.mil/cci">CCI-000999</xccdf-1.2:ident>
        </xccdf-1.2:Rule>
      </xccdf-1.2:Group>
    </xccdf-1.2:Benchmark>
  </ds:component>
</ds:data-stream-collection>
